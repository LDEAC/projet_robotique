import matplotlib.pyplot as plot
import time
import warnings
import sys

sys.tracebacklimit = 0
warnings.filterwarnings("ignore", ".*GUI is implemented.*")

# plot data (global)
x_data = []
y_data = []



def run_plot():
    plot.ion()
    print("ok1")
    plot_handle, = plot.plot([-1, 70], [-1, 4000], marker='o')  # initialise

    try:
        for i in range(60):
            x_data.append(i)
            print("ok2")
            y_data.append(i * i)

            plot_handle.set_xdata(x_data)
            plot_handle.set_ydata(y_data)

            plot.draw()
            while True:
                plot.pause(0.05)
                break

    except KeyboardInterrupt:
        time.sleep(1)
        plot.close()
        print("Fin du programme\n")
        pass
        
if __name__ == "__main__":
    run_plot()
